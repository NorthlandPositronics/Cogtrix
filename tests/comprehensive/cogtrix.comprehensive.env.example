# ============================================================================
# Comprehensive-test secrets — TEMPLATE
# ============================================================================
# Copy this file to `.env` in the same directory and fill in the real values:
#
#     cp cogtrix.comprehensive.env.example .env
#
# `.env` is gitignored (see tests/comprehensive/.gitignore) — NEVER commit it.
# These values are loaded into the environment at test start by
# tests/comprehensive/env_loader.py and consumed by cogtrix.comprehensive.yaml.
# ============================================================================

# Local self-hosted vLLM "spark" endpoint key (generic per-provider override, #2222).
COGTRIX_PROVIDER_SPARK_API_KEY=

# Cloud model used by the Gate-2 eval.
DEEPSEEK_API_KEY=

# Tools.
TAVILY_API_KEY=
OPENWEATHER_API_KEY=

# Optional: override the data dir for in-process (non-container) harness runs.
# COGTRIX_DATA_DIR=/tmp/cogtrix-comprehensive
