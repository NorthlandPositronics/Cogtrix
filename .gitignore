# ── Runtime data (sessions, history, vector stores) ──────────────
# The entire data/ directory contains user-specific runtime state:
# conversation history, readline history, vector DB embeddings.
data/

# ── Logs (may contain full LLM interactions in debug mode) ───────
*.log

